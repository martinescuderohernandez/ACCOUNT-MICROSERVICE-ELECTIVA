# ==========================================
# Application Configuration
# ==========================================
APP_NAME="Account Microservice"
APP_ENV=development
DEBUG=True
PORT=8000

# ==========================================
# Database Configuration (TiDB / MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=accounts_db

# ==========================================
# Apache Kafka Configuration (Aiven)
# ==========================================
KAFKA_ENABLED=True
KAFKA_BOOTSTRAP_SERVERS=kafka-11a18fa7......
KAFKA_TOPIC_ACCOUNT_CREATED=account-created-topic
KAFKA_SECURITY_PROTOCOL=SSL

# ------------------------------------------
# OPCIÓN A (Local / Docker Compose):
# Rutas locales relativas o absolutas
# ------------------------------------------
KAFKA_SSL_CAFILE=./certs/ca.pem
KAFKA_SSL_CERTFILE=./certs/service.cert
KAFKA_SSL_KEYFILE=./certs/service.key

# ------------------------------------------
# OPCIÓN B (Render - Secret Files):
# Render monta los archivos secretos en /etc/secrets/
# ------------------------------------------
# KAFKA_SSL_CAFILE=/etc/secrets/ca.pem
# KAFKA_SSL_CERTFILE=/etc/secrets/service.cert
# KAFKA_SSL_KEYFILE=/etc/secrets/service.key

# ------------------------------------------
# OPCIÓN C (Render - Base64 Env Vars):
# Alternativa: pasar el contenido codificado en Base64
# (base64 -i certs/ca.pem)
# ------------------------------------------
# KAFKA_SSL_CA_BASE64=
# KAFKA_SSL_CERT_BASE64=
# KAFKA_SSL_KEY_BASE64=
