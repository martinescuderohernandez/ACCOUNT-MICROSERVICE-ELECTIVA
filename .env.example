# ==========================================
# Application Configuration
# ==========================================
APP_NAME="Account Microservice"
APP_ENV=development
DEBUG=True
PORT=8000

# ==========================================
# Database Configuration (TiDB / MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=accounts_db

# ==========================================
# Apache Kafka Configuration (Aiven)
# ==========================================
KAFKA_ENABLED=True
KAFKA_BOOTSTRAP_SERVERS=kafka-11a18fa7......
KAFKA_TOPIC_ACCOUNT_CREATED=account-created-topic
KAFKA_SECURITY_PROTOCOL=SSL


KAFKA_SSL_CAFILE=./certs/ca.pem
KAFKA_SSL_CERTFILE=./certs/service.cert
KAFKA_SSL_KEYFILE=./certs/service.key
